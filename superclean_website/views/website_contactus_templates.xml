<odoo>
    <template id="contactus_form_zip" inherit_id="website.contactus" name="Contact Form — Zip">
        <xpath expr="//input[@name='company']/parent::div"
               position="after">
            <div class="mb-3 col-lg-6 s_website_form_field s_website_form_model_required"
                 data-type="char" data-name="Field">
                <label class="s_website_form_label" style="width: 200px" for="contactZip">
                    <span class="s_website_form_label_content">Code postal</span>
                </label>
                <input id="contactZip"
                       type="text"
                       class="form-control s_website_form_input"
                       name="zip"
                       pattern="^\d{5}$"
                       maxlength="5"
                       inputmode="numeric"
                       autocomplete="postal-code"
                       title="Le code postal français doit comporter exactement 5 chiffres"
                       placeholder="75008"/>
            </div>
        </xpath>
    </template>
</odoo>
